# Required in production. Refuses to start without it (unless DEMO_MODE=true).
# NOTE: this file is only a template — copy it to `.env` and edit THAT:
#   cp .env.example .env
ADMIN_PASSWORD=change-me

# Cookie-signing secret. Optional — a random one is generated per boot if unset
# (admins just get logged out on restart).
SESSION_SECRET=

# Demo mode: forces the survey window open and shows a "fake data" banner.
DEMO_MODE=false

# Anonymity floor: aggregates are hidden until a month has this many responses.
MIN_RESPONSES_TO_SHOW=5

# Where the SQLite file lives (default ./data).
DATA_DIR=

# ---- Email invites ----
# EASIEST (no mail-server access needed): set GOOGLE_CLIENT_ID +
# GOOGLE_CLIENT_SECRET (console.cloud.google.com > Credentials > OAuth client),
# then click "Connect Gmail" on the admin dashboard once. Invites send from
# that person's own Gmail via the gmail.send scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=khalid@k-brands.com,amna@k-brands.com

# Team list precedence: Sage HR (if configured) > TEAM_EMAILS (comma list) > BigQuery roster.
TEAM_EMAILS=

# ALTERNATIVE: classic SMTP (any provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Team Pulse <pulse@k-brands.com>"
# Public URL used inside the emailed links.
APP_URL=http://localhost:8080
# true = automatically email everyone their unique link when the monthly
# window opens (never runs in demo mode).
AUTO_EMAIL=false

# PHASE 2 — peer feedback module. Leave false unless leadership has formally
# sponsored a 360 process. See README.
MANAGEMENT_SPONSORED=false

PORT=8080

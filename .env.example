# Required in production. Refuses to start without it (unless DEMO_MODE=true).
# NOTE: this file is only a template — copy it to `.env` and edit THAT:
#   cp .env.example .env
ADMIN_PASSWORD=change-me

# Cookie-signing secret. Optional — a random one is generated per boot if unset
# (admins just get logged out on restart).
SESSION_SECRET=

# Demo mode: forces the survey window open and shows a "fake data" banner.
DEMO_MODE=false

# Anonymity floor: aggregates are hidden until a month has this many responses.
MIN_RESPONSES_TO_SHOW=5

# Where the SQLite file lives (default ./data).
DATA_DIR=

# ---- Google (sign-in, email sending, Sheets mirror) ----
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET come from console.cloud.google.com >
# Credentials > OAuth client. Then click "Connect Google" on /admin/invites
# once — that grants gmail.send + Sheets + Drive, so invites send from that
# person's own account and every response mirrors to the "Team Pulse Data"
# spreadsheet in their Drive. Admin sign-in is Google-only, restricted to
# ADMIN_EMAILS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=khalid@k-brands.com,amna@k-brands.com

# ---- Team roster ----
# Precedence: Sage HR (live directory, if configured) > TEAM_EMAILS > BigQuery.
# TEAM_EMAILS format, entries separated by ";":
#   Full Name <email@host> | Job title; Next Person <email2@host> | Role
# (bare comma/space-separated addresses also still work)
SAGEHR_SUBDOMAIN=
SAGEHR_API_KEY=
TEAM_EMAILS=

# ALTERNATIVE: classic SMTP (any provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Team Pulse <pulse@k-brands.com>"
# Public URL used inside the emailed links.
APP_URL=http://localhost:8080
# true = automatically email everyone their unique link when the monthly
# window opens (never runs in demo mode).
AUTO_EMAIL=false

# PHASE 2 — peer feedback module. Leave false unless leadership has formally
# sponsored a 360 process. See README.
MANAGEMENT_SPONSORED=false

# Where the always-current HTML report is written on this machine
# (default: ~/Team Pulse Data). Rewritten after every response.
LOCAL_EXPORT_DIR=

# For scale-to-zero hosts (Cloud Run): in-process timers can't be trusted
# there, so set a secret and point Cloud Scheduler at POST /api/cron/tick
# with header X-Cron-Secret. Endpoint is disabled while this is unset.
CRON_SECRET=

PORT=8080

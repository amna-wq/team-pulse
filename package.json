{
  "name": "team-pulse",
  "version": "1.0.0",
  "description": "Team Pulse & Feedback — monthly anonymous team health survey (aggregates only, never individuals)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
